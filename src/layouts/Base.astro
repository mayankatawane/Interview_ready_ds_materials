---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import { url } from '../lib/content';

interface Props { title: string; description?: string; active?: 'home' | 'questions' | 'quiz' | 'search' | ''; }
const { title, description = 'Simple, visual revision notes for data science interviews.', active = '' } = Astro.props;
const fullTitle = title === 'Home' ? 'DS Interview Kit' : `${title} · DS Interview Kit`;
const nav = [
  { id: 'home', href: url(''), label: 'Home', icon: 'M3 10.5 12 3l9 7.5V21h-6v-6H9v6H3z' },
  { id: 'questions', href: url('questions/'), label: 'Questions', icon: 'M4 5h16M4 12h16M4 19h10' },
  { id: 'quiz', href: url('quiz/'), label: 'Quiz', icon: 'M9 11l3 3 8-8M20 12v7a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h9' },
  { id: 'search', href: url('search/'), label: 'Search', icon: 'M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14zM21 21l-5-5' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0d6b5b" />
  <link rel="manifest" href={url('manifest.webmanifest')} />
  <link rel="icon" href={url('icons/icon.svg')} type="image/svg+xml" />
  <link rel="apple-touch-icon" href={url('icons/icon-192.png')} />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-title" content="DS Kit" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Mono:wght@400;500&display=swap" />
  <script is:inline>
    try { const t = localStorage.getItem('dsk-theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
    window.DSK = { get(k, d) { try { const v = JSON.parse(localStorage.getItem(k)); return v == null ? d : v; } catch (e) { return d; } }, set(k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) {} } };
  </script>
</head>
<body>
  <header class="topbar">
    <div class="inner wrap">
      <a class="brand" href={url('')}><span class="mark">DS</span>DS Interview Kit</a>
      <nav class="topnav" aria-label="Main">
        {nav.map((n) => (
          <a class="desk" href={n.href} aria-current={active === n.id ? 'page' : undefined}>
            <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={n.icon} /></svg>
            <span class="label">{n.label}</span>
          </a>
        ))}
        <button class="iconbtn" id="recallBtn" type="button" aria-pressed="false" title="Recall mode: blur the model answers so you say yours first">
          <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z" /><circle cx="12" cy="12" r="3" /></svg>
          <span class="label">Recall</span>
        </button>
        <button class="iconbtn" id="themeBtn" type="button" aria-label="Switch light or dark theme">
          <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
        </button>
      </nav>
    </div>
  </header>
  <main class="page wrap" id="main">
    <slot />
  </main>
  <footer class="foot wrap">Built for revision on the go. Progress and notes are saved on this device.</footer>
  <nav class="tabbar" aria-label="Main">
    {nav.map((n) => (
      <a href={n.href} aria-current={active === n.id ? 'page' : undefined}>
        <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={n.icon} /></svg>
        {n.label}
      </a>
    ))}
  </nav>
  <script is:inline define:vars={{ swUrl: url('sw.js'), scope: url('') }}>
    const S = window.DSK;
    const tb = document.getElementById('themeBtn');
    tb.addEventListener('click', () => {
      const dark = document.documentElement.dataset.theme ? document.documentElement.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      const next = dark ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem('dsk-theme', next); } catch (e) {}
    });
    const rb = document.getElementById('recallBtn');
    const setRecall = (on) => { document.body.classList.toggle('recall', on); rb.setAttribute('aria-pressed', on); rb.style.color = on ? 'var(--accent)' : ''; };
    setRecall(!!S.get('dsk-recall', false));
    rb.addEventListener('click', () => { const on = !document.body.classList.contains('recall'); S.set('dsk-recall', on); setRecall(on); document.querySelectorAll('.callout-say').forEach((c) => c.classList.remove('show')); });
    document.addEventListener('click', (e) => { const c = e.target.closest('.callout-say'); if (c && document.body.classList.contains('recall')) c.classList.toggle('show'); });
    if ('serviceWorker' in navigator && location.protocol === 'https:') navigator.serviceWorker.register(swUrl, { scope }).catch(() => {});
  </script>
</body>
</html>
